# ==========================================
# Genesis'26 Environment Configuration
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# PayPal API Credentials (Get these from https://developer.paypal.com)
# Set to 'sandbox' for testing or 'live' for production
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_HERE

# Payment / Registration Settings
# Base registration fee shown in INR
REGISTRATION_FEE_INR=200

# Currency used for PayPal checkout (e.g. USD, EUR, INR)
# Note: PayPal standard sandbox accounts accept USD natively worldwide
PAYPAL_CURRENCY=USD
PAYPAL_AMOUNT=2.50

# Admin PIN for Symposium Coordinator Dashboard
ADMIN_PIN=2026

# Allowed Frontend Origins (comma separated)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
